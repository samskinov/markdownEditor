<Window x:Class="MarkdownEditor.Views.BusyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MarkdownEditor.ViewModels"
        Title="Processing"
        Width="520" Height="400"
        MinWidth="400" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F8F9FB">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarkdownEditor;component/Themes/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <!-- Subtitle -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Subtitle}"
                   FontSize="12.5"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding Subtitle, Converter={x:Static vm:StringNotEmptyToVisibilityConverter.Instance}}" />

        <!-- Progress bar (indeterminate while in progress) -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,12"
                     Background="#E2E4E9"
                     Foreground="{StaticResource PrimaryBrush}"
                     BorderThickness="0"
                     Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}" />

        <!-- Steps list -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,16">
            <ScrollViewer x:Name="StepsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,8">
                <ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BusyStep}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="13"
                                           Foreground="{Binding IconColor}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="6,0,0,0"
                                           LineHeight="19" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer: completion status + Close button -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Left"
                       Text="✔  Completed"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#10B981"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="In progress…"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Close"
                    Width="100"
                    Height="34"
                    IsEnabled="{Binding IsCompleted}"
                    Style="{StaticResource ToolbarAccentButtonStyle}"
                    Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
