<UserControl x:Class="MarkdownEditor.Views.MarkdownEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:vm="clr-namespace:MarkdownEditor.ViewModels"
             xmlns:svc="clr-namespace:MarkdownEditor.Services"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarkdownEditor;component/Themes/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding InsertBoldCommand}" />
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding InsertItalicCommand}" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding InsertLinkCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════ TOOLBAR ═══════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel>

                <!-- Save (always visible, far left) -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarAccentButtonStyle}"
                        Command="{Binding SaveCommand}"
                        ToolTip="Save (Ctrl+S)"
                        Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- Undo / Redo -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding UndoCommand}"
                        ToolTip="Undo (Ctrl+Z)">
                    <TextBlock Text="↩" FontSize="15" />
                </Button>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding RedoCommand}"
                        ToolTip="Redo (Ctrl+Y)">
                    <TextBlock Text="↪" FontSize="15" />
                </Button>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- Format: Bold / Italic (shortcuts always accessible) -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding InsertBoldCommand}"
                        ToolTip="Bold (Ctrl+B)">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding InsertItalicCommand}"
                        ToolTip="Italic (Ctrl+I)">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="14" FontFamily="Georgia" />
                </Button>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- ▾ Headings dropdown -->
                <Menu DockPanel.Dock="Left" Style="{StaticResource ToolbarMenuStyle}">
                    <MenuItem Header="H# ▾" Style="{StaticResource ToolbarMenuItemStyle}" ToolTip="Headings">
                        <MenuItem Header="# H1 — Heading 1" Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertH1Command}" />
                        <MenuItem Header="## H2 — Heading 2" Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertH2Command}" />
                        <MenuItem Header="### H3 — Heading 3" Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertH3Command}" />
                    </MenuItem>
                </Menu>

                <!-- ▾ Insert dropdown -->
                <Menu DockPanel.Dock="Left" Style="{StaticResource ToolbarMenuStyle}">
                    <MenuItem Header="Insert ▾" Style="{StaticResource ToolbarMenuItemStyle}" ToolTip="Insert elements">
                        <MenuItem Header="☰  Bulleted list"   Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertBulletListCommand}" />
                        <MenuItem Header="1. Numbered list"   Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertNumberedListCommand}" />
                        <MenuItem Header="☑  Checklist"       Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertChecklistCommand}" />
                        <Separator Style="{StaticResource ToolbarDropdownSeparatorStyle}" />
                        <MenuItem Header="❝  Quote"           Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertQuoteCommand}" />
                        <MenuItem Header="&lt;/&gt; Inline code" Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertInlineCodeCommand}" />
                        <MenuItem Header="{}{ } Code block"     Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertCodeBlockCommand}" />
                        <Separator Style="{StaticResource ToolbarDropdownSeparatorStyle}" />
                        <MenuItem Header="🔗  Link (Ctrl+K)"  Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertLinkCommand}" />
                        <MenuItem Header="🖼  Image"          Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertImageCommand}" />
                        <MenuItem Header="▦  Table"           Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertTableCommand}" />
                        <MenuItem Header="―  Horizontal rule" Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertHorizontalRuleCommand}" />
                        <Separator Style="{StaticResource ToolbarDropdownSeparatorStyle}" />
                        <MenuItem Header="◈  Mermaid block"   Style="{StaticResource ToolbarDropdownItemStyle}" Command="{Binding InsertMermaidBlockCommand}" />
                    </MenuItem>
                </Menu>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- TOC toggle -->
                <ToggleButton DockPanel.Dock="Left"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              IsChecked="{Binding IsTocOpen, Mode=TwoWay}"
                              ToolTip="Table of Contents">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☰" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="TOC" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ToggleButton>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- Help toggles -->
                <ToggleButton DockPanel.Dock="Left"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              IsChecked="{Binding IsMarkdownHelpOpen, Mode=TwoWay}"
                              ToolTip="Markdown help panel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📝" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="MD" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton DockPanel.Dock="Left"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              IsChecked="{Binding IsMermaidHelpOpen, Mode=TwoWay}"
                              ToolTip="Mermaid help panel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="MMD" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ToggleButton>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- Preview (far left, but before the Fill spacer) -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarAccentButtonStyle}"
                        Command="{Binding OpenPreviewCommand}"
                        ToolTip="Open preview in browser">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="Preview" FontSize="12" />
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- AI documentation prompt -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding GenerateAiPromptCommand}"
                        ToolTip="Generate prompt for IA documentation">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="AI Prompt" FontSize="12" />
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

                <!-- Fix Mermaid syntax with AI -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding GenerateMermaidFixPromptCommand}"
                        ToolTip="Generate an AI prompt to fix the Mermaid block at the cursor position">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="Fix Mermaid" FontSize="12" />
                    </StackPanel>
                </Button>

                <!-- Spacer -->
                <Border />
            </DockPanel>
        </Border>
        <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Editor -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,8"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="MARKDOWN EDITOR"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                    <avalonEdit:TextEditor
                        x:Name="MarkdownTextEditor"
                        Grid.Row="1"
                        FontFamily="Cascadia Code, Fira Code, Consolas, Courier New"
                        FontSize="14"
                        ShowLineNumbers="True"
                        WordWrap="True"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        Padding="8,6"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        LineNumbersForeground="{StaticResource TextMutedBrush}"
                        BorderThickness="0" />
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Style="{StaticResource ModernGridSplitterStyle}"
                          Visibility="{Binding IsTocOpen, Converter={StaticResource BoolToVis}}" />

            <!-- TOC Panel -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsTocOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,8"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="OUTLINE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TocEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:TocEntry}">
                                    <Button Click="TocEntry_Click"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="12,4"
                                                        CornerRadius="4"
                                                        Margin="4,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBgBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="{Binding Level, Converter={x:Static svc:HeadingLevelToMarginConverter.Instance}}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Help panel splitter -->
            <GridSplitter Grid.Column="3"
                          Style="{StaticResource ModernGridSplitterStyle}"
                          Visibility="{Binding IsAnyHelpOpen, Converter={StaticResource BoolToVis}}" />

            <!-- Inline Help Panel (Markdown + Mermaid tabs) -->
            <Border Grid.Column="4"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsAnyHelpOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tab header row -->
                    <DockPanel Grid.Row="0"
                               Background="{StaticResource BackgroundBrush}"
                               LastChildFill="False">
                        <ToggleButton DockPanel.Dock="Left"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      IsChecked="{Binding IsMarkdownHelpOpen, Mode=TwoWay}"
                                      Margin="6,4,2,4"
                                      Padding="10,5"
                                      ToolTip="Markdown syntax reference">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="Markdown" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton DockPanel.Dock="Left"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      IsChecked="{Binding IsMermaidHelpOpen, Mode=TwoWay}"
                                      Margin="2,4,6,4"
                                      Padding="10,5"
                                      ToolTip="Mermaid diagram examples">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="Mermaid" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </ToggleButton>
                    </DockPanel>

                    <!-- Search box (Markdown) -->
                    <TextBox Grid.Row="1"
                             Margin="10,4,10,4"
                             Tag="🔍 Filter snippets…"
                             Style="{StaticResource HelpSearchBoxStyle}"
                             Text="{Binding MarkdownHelpVM.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsMarkdownHelpOpen, Converter={StaticResource BoolToVis}}" />

                    <!-- Search box (Mermaid) -->
                    <TextBox Grid.Row="1"
                             Margin="10,4,10,4"
                             Tag="🔍 Filter examples…"
                             Style="{StaticResource HelpSearchBoxStyle}"
                             Text="{Binding MermaidHelpVM.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsMermaidHelpOpen, Converter={StaticResource BoolToVis}}" />

                    <!-- Markdown snippets list -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="6,0"
                                  Visibility="{Binding IsMarkdownHelpOpen, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding MarkdownHelpVM.FilteredSnippets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HelpItemBorderStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Insert"
                                                        Style="{StaticResource HelpInsertButtonStyle}"
                                                        Command="{Binding DataContext.MarkdownHelpVM.InsertSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Top"
                                                        Margin="8,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource HelpItemTitleStyle}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource HelpItemDescStyle}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Syntax}"
                                                       Style="{StaticResource HelpCodeBlockStyle}"
                                                       MaxHeight="80"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Mermaid examples list -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="6,0"
                                  Visibility="{Binding IsMermaidHelpOpen, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding MermaidHelpVM.FilteredExamples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HelpItemBorderStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="Insert"
                                                        Style="{StaticResource HelpInsertButtonStyle}"
                                                        Command="{Binding DataContext.MermaidHelpVM.InsertExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Top"
                                                        Margin="8,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource HelpItemTitleStyle}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource HelpItemDescStyle}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Code}"
                                                       Style="{StaticResource HelpCodeBlockStyle}"
                                                       MaxHeight="120"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════ STATUS BAR ═══════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource StatusBarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="4,3">
            <DockPanel>
                <!-- Left side -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Background="{Binding IsModified, Converter={StaticResource BoolToVis}}"
                            Visibility="Collapsed" />
                    <Border CornerRadius="4" Padding="8,2" Margin="4,0"
                            Background="{StaticResource HoverBgBrush}">
                        <TextBlock Style="{StaticResource StatusTextStyle}">
                            <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <TextBlock Style="{StaticResource StatusTextStyle}">
                        <Run Text="Ln " /><Run Text="{Binding CursorLine, Mode=OneWay}" />
                        <Run Text=", Col " /><Run Text="{Binding CursorColumn, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Right side -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource StatusTextStyle}">
                        <Run Text="{Binding CharCount, Mode=OneWay}" />
                        <Run Text=" characters" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatusTextStyle}">
                        <Run Text="{Binding LineCount, Mode=OneWay}" />
                        <Run Text=" lines" />
                    </TextBlock>
                    <Border CornerRadius="4" Padding="8,2" Margin="4,0"
                            Background="{StaticResource HoverBgBrush}"
                            Visibility="{Binding IsPreviewActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource StatusTextStyle}"
                                   Foreground="#10B981"
                                   Text="● Preview active" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
