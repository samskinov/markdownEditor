<Window x:Class="MarkdownEditor.Views.MermaidHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MarkdownEditor.ViewModels"
        Title="Mermaid Help — Diagrams"
        Width="520" Height="700"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FB"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarkdownEditor;component/Themes/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📊 Mermaid Examples"
                       Style="{StaticResource HelpPanelHeaderStyle}" />
            <TextBlock Text="Click \u2018Insert\u2019 to add a diagram to the editor."
                       FontSize="12.5"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Examples}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HelpItemBorderStyle}">
                            <StackPanel>
                                <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                            Content="Insert"
                                            Style="{StaticResource HelpInsertButtonStyle}"
                                            Command="{Binding DataContext.InsertExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Top"
                                            Margin="8,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource HelpItemTitleStyle}" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource HelpItemDescStyle}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Code}"
                                           Style="{StaticResource HelpCodeBlockStyle}"
                                           MaxHeight="120"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
